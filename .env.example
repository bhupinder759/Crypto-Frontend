# Copy to .env.local and adjust. All values are public (exposed to the browser).

# NestJS backend REST base URL (used by the Next.js route handlers and socket.io)
NEXT_PUBLIC_BACKEND_HTTP_URL=http://localhost:4000

# Backend raw WebSocket endpoint (order book / trades stream)
NEXT_PUBLIC_BACKEND_WS_URL=ws://localhost:4000/ws

# Public URL of this frontend (metadata, sitemap)
NEXT_PUBLIC_APP_URL=http://localhost:3000
